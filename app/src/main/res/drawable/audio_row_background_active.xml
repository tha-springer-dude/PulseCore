<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="start">
        <shape>
            <corners
